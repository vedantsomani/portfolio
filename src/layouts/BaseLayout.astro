---
import { ClientRouter } from 'astro:transitions';
import { PUBLIC_CF_BEACON_TOKEN } from 'astro:env/client';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { EventName } from '../lib/track';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/motion.css';
import '../styles/film.css';
import '../styles/archive.css';
import '../styles/scroll.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description: string;
  /** OG image key: public/og/<key>.png, generated by scripts/og.mjs. */
  og?: string;
  /** Path for the canonical URL; defaults to the current path. */
  canonical?: string;
  /** Page opens with a full-bleed field that sits under the transparent nav. */
  underNav?: boolean;
  noindex?: boolean;
  /** Event from SITE_SPEC §7 fired when the page is viewed. */
  trackView?: EventName;
  /** Preload the Archivo file (default). See the note in <head>. */
  fontPreload?: boolean;
  /** The home page: one screen, the lab as the interface; no footer under it (with JS). */
  experience?: boolean;
}

const {
  title,
  description,
  og = 'home',
  canonical,
  underNav = false,
  noindex = false,
  trackView,
  fontPreload = true,
  experience = false,
} = Astro.props;
// Canonical path: absolute on the production domain, no ".html", no "/index", no trailing slash
// (home is "/"). Noindex pages (404) get no canonical at all.
const canonicalPath =
  (canonical ?? Astro.url.pathname)
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/+$/, '$1') || '/';
const canonicalURL = noindex ? null : new URL(canonicalPath, Astro.site).href;
const fullTitle = title === 'Vedant Somani' ? title : `${title} | Vedant Somani`;
const ogImage = new URL(`/og/${og}.png`, Astro.site).href;
// Cloudflare Web Analytics: cookieless page views. `spa` follows ClientRouter navigations.
const beacon =
  import.meta.env.PROD && PUBLIC_CF_BEACON_TOKEN
    ? JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN, spa: true })
    : null;
---

<!doctype html>
<html lang="en-IN" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#050605" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Preloaded so the swap to Archivo lands before layout settles: the expanded display cut has no
         metric-compatible fallback, so a late swap shifts headings (CLS). Pages whose LCP is an image
         and whose opening type barely moves on swap opt out, because there the preload only competes
         with that image for bandwidth: Home (headline held for its reveal) and Projects (measured
         CLS 0.008 without it). */}
    {fontPreload && (
      <link
        rel="preload"
        href="/fonts/archivo-latin-var.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vedant Somani" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    {/* Before first paint: record the motion preference, hold the below-the-fold reveals, and hold
         the hero headline for its one-per-session reveal. CSS failsafes (motion.css) show both if
         the scripts never run. */}
    <script is:inline>
      (function () {
        function apply() {
          const d = document.documentElement;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          d.dataset.motion = reduce ? 'reduce' : 'ok';
          if (!reduce) d.dataset.reveals = 'pending';
          try {
            if (!reduce && !sessionStorage.getItem('hero-revealed')) d.dataset.reveal = 'pending';
            // Cold open: home, first visit this session, motion allowed (IntroCredits, intro.ts),
            // and not a link to a place further down it (/#lab, /#transmission).
            if (
              !reduce &&
              location.pathname === '/' &&
              !location.hash &&
              !sessionStorage.getItem('intro-seen')
            )
              d.dataset.intro = 'pending';
          } catch {
            // Storage blocked: skip the reveal rather than risk hiding the headline.
          }
        }
        apply();
        // ClientRouter replaces <html> attributes with the new page's on every navigation.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ 'under-nav': underNav, experience }} data-track-view={trackView}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {/* Grain and vignette over everything; persisted so the grain never restarts on a cut. */}
    <div class="film" aria-hidden="true" transition:persist="film"></div>
    {/* Page-transition panel. Persisted so it can cover the old page and uncover the new one. */}
    <div class="wipe" aria-hidden="true" transition:persist="wipe" data-wipe></div>
    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={beacon}
      ></script>
    )}
    <script>
      import { track, type EventName } from '../lib/track';
      import { initTransitions } from '../scripts/transitions';
      import { onPage } from '../scripts/lifecycle';
      import { initReveals } from '../scripts/reveal';
      import { onSoundChange, resumeOnGesture, setSound, soundOn } from '../scripts/sound';

      // One delegated listener: any element with data-track="event_name" reports its clicks.
      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (el?.dataset.track) track(el.dataset.track as EventName);
      });
      // Page-level views: <body data-track-view="contact_open">.
      document.addEventListener('astro:page-load', () => {
        const view = document.body.dataset.trackView;
        if (view) track(view as EventName);
      });
      initTransitions();
      onPage(initReveals);

      // Sound toggle in the nav: shown only with JS, mirrors the stored choice.
      resumeOnGesture();
      const syncToggle = (on: boolean) =>
        document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]').forEach((b) => {
          b.hidden = false;
          b.setAttribute('aria-pressed', String(on));
        });
      onSoundChange(syncToggle);
      document.addEventListener('astro:page-load', () => syncToggle(soundOn()));
      document.addEventListener('click', (event) => {
        if ((event.target as Element | null)?.closest('[data-sound-toggle]')) setSound(!soundOn());
      });
    </script>
  </body>
</html>
