---
import { ClientRouter } from 'astro:transitions';
import { PUBLIC_CF_BEACON_TOKEN } from 'astro:env/client';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { EventName } from '../lib/track';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  /** OG image key: public/og/<key>.png, generated by scripts/og.mjs. */
  og?: string;
  /** Path for the canonical URL; defaults to the current path. */
  canonical?: string;
  /** Page opens with a full-bleed field that sits under the transparent nav. */
  underNav?: boolean;
  noindex?: boolean;
  /** Event from SITE_SPEC §7 fired when the page is viewed. */
  trackView?: EventName;
  /** Preload the Archivo file (default). See the note in <head>. */
  fontPreload?: boolean;
}

const {
  title,
  description,
  og = 'home',
  canonical,
  underNav = false,
  noindex = false,
  trackView,
  fontPreload = true,
} = Astro.props;
// Canonical path: absolute on the production domain, no ".html", no "/index", no trailing slash
// (home is "/"). Noindex pages (404) get no canonical at all.
const canonicalPath =
  (canonical ?? Astro.url.pathname)
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/+$/, '$1') || '/';
const canonicalURL = noindex ? null : new URL(canonicalPath, Astro.site).href;
const fullTitle = title === 'Vedant Somani' ? title : `${title} | Vedant Somani`;
const ogImage = new URL(`/og/${og}.png`, Astro.site).href;
// Cloudflare Web Analytics: cookieless page views. `spa` follows ClientRouter navigations.
const beacon =
  import.meta.env.PROD && PUBLIC_CF_BEACON_TOKEN
    ? JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN, spa: true })
    : null;
---

<!doctype html>
<html lang="en-IN" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#14100E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Preloaded so the swap to Archivo lands before layout settles: the expanded display cut has no
         metric-compatible fallback, so a late swap shifts headings (CLS). Home opts out: its headline
         is held for the reveal until after the font arrives, and there the preload only competes
         with the LCP photo for bandwidth. */}
    {fontPreload && (
      <link
        rel="preload"
        href="/fonts/archivo-latin-var.woff2"
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vedant Somani" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />

    {/* Before first paint: record the motion preference, and hold the hero headline for its
         one-per-session reveal. A CSS failsafe (motion.css) shows it if the script never runs. */}
    <script is:inline>
      (function () {
        function apply() {
          const d = document.documentElement;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          d.dataset.motion = reduce ? 'reduce' : 'ok';
          try {
            if (!reduce && !sessionStorage.getItem('hero-revealed')) d.dataset.reveal = 'pending';
          } catch {
            // Storage blocked: skip the reveal rather than risk hiding the headline.
          }
        }
        apply();
        // ClientRouter replaces <html> attributes with the new page's on every navigation.
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ 'under-nav': underNav }} data-track-view={trackView}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {/* Page-transition panel. Persisted so it can cover the old page and uncover the new one. */}
    <div class="wipe" aria-hidden="true" transition:persist="wipe" data-wipe></div>
    {beacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={beacon}
      ></script>
    )}
    <script>
      import { track, type EventName } from '../lib/track';
      import { initTransitions } from '../scripts/transitions';

      // One delegated listener: any element with data-track="event_name" reports its clicks.
      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (el?.dataset.track) track(el.dataset.track as EventName);
      });
      // Page-level views: <body data-track-view="contact_open">.
      document.addEventListener('astro:page-load', () => {
        const view = document.body.dataset.trackView;
        if (view) track(view as EventName);
      });
      initTransitions();
    </script>
  </body>
</html>
