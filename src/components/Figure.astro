---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// AVIF with a JPG fallback, intrinsic width/height always set, lazy unless `priority`.
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  caption?: string;
  class?: string;
}
const {
  src,
  alt,
  sizes,
  widths = [480, 800, 1200, 1600, 2400],
  priority = false,
  caption,
  class: className,
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---

<figure class:list={['figure', className]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif']}
    fallbackFormat="jpg"
    widths={usable}
    sizes={sizes}
    width={src.width}
    height={src.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    quality={priority ? 60 : 55}
  />
  {(caption || Astro.slots.has('caption')) && (
    <figcaption class="figure__caption t-small">
      {caption}
      <slot name="caption" />
    </figcaption>
  )}
</figure>
