---
/*
  Placeholder "VEDANT" wordmark drawn as PCB traces. TODO(vedant): final SVG.

  Construction (1u = 1/8 cap height):
  - Trace centrelines sit on a 4u × 8u box per letter; stroke is 1u, so each glyph is 5u wide.
  - Letter advance is 7u, leaving 2u clearance between traces of neighbouring letters.
  - Routing is 0°/45°/90° only. Direction changes are 45° chamfers; right angles only at T-junctions
    and on the square back of the D.
  - Free trace ends terminate in a round pad (2u across) with a 0.9u drill that shows the background.
  - ViewBox pads 1u on every side for pad overhang: 41u × 10u.
*/
// Decorative by default: the link around it carries the accessible name. Pass `label` only when
// the wordmark stands alone as an image.
import { height, pads, traces, width } from '../lib/wordmark.js';

interface Props {
  size?: 'nav' | 'footer' | 'large';
  label?: string;
  class?: string;
}
const { size = 'nav', label, class: className } = Astro.props;

const maskId = `wm-drill-${size}`;
---

<svg
  class:list={['wordmark', `wordmark--${size}`, className]}
  viewBox={`0 0 ${width} ${height}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width={width} height={height}>
      <rect width={width} height={height} fill="#fff"></rect>
      {pads.map(([x, y]) => (
        <circle cx={x} cy={y} r="0.45" fill="#000" />
      ))}
    </mask>
  </defs>
  <g mask={`url(#${maskId})`} fill="none" stroke="currentColor" stroke-width="1">
    {traces.map((d) => (
      <path d={d} stroke-linejoin="miter" stroke-linecap="square" />
    ))}
    {pads.map(([x, y]) => (
      <circle cx={x} cy={y} r="1" fill="currentColor" stroke="none" />
    ))}
  </g>
</svg>
