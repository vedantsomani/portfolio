---
// A case study as a recovered record (SITE_SPEC §5): retrieval (RecordHead) → briefing → the
// record's chapters from the MDX, where every figure is a numbered exhibit with its evidence class
// and measurements read as sourced readouts → the end of the record (RecordEnd): status, sealed or
// public links, and the next record. Restricted projects (AGENTS.md rule 3) never show a
// repository link; the schema refuses one.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordHead from './RecordHead.astro';
import RecordEnd from './RecordEnd.astro';
import Figure from './Figure.astro';
import CaseSection from './CaseSection.astro';
import ArchDiagram from './ArchDiagram.astro';
import Readout from './Readout.astro';
import BoardStory from './BoardStory.astro';
import TesseraScenes from './TesseraScenes.astro';
import Todo from './Todo.astro';
import { SHOW_TODOS } from '../lib/todo';
import { getDossiers } from '../lib/dossiers';
import { recordIds, renderedSections, sectionId, statusLabel, type Project } from '../lib/content';
import { closeUp } from '../lib/lab-set';

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const status = statusLabel(d.status);
const url = new URL(`/projects/${project.id}`, Astro.site).href;
const ids = await recordIds();
const idOf = (p: Project) => ids.get(`projects/${p.id}`) ?? 'R-00';
const recordId = idOf(project);
const withheld = d.restricted
  ? (await getDossiers()).find((x) => x.id === project.id)?.withheld
  : undefined;

// Only what the page shows: name, summary, author, status, year.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  description: d.summary,
  url,
  image: new URL(`/og/project-${project.id}.png`, Astro.site).href,
  author: { '@type': 'Person', name: 'Vedant Somani', url: Astro.site?.href },
  ...(status && { creativeWorkStatus: status }),
  ...(d.year && { dateCreated: d.year }),
};

const facts = [
  { label: 'Year', value: d.year, todo: 'year' },
  { label: 'Role', value: d.role.join(', ') || undefined, todo: 'role' },
  // Credit, never a TODO: only projects built on someone else's work carry it.
  ...(d.builtOn ? [{ label: 'Built on', value: d.builtOn, todo: '' }] : []),
  ...(d.specs ?? []).map((sp) => ({ label: sp.label, value: sp.value, mono: true, todo: '' })),
].filter((f) => f.value || SHOW_TODOS);

const links = d.restricted
  ? []
  : [
      d.repoUrl && { href: d.repoUrl, label: 'Source repository', track: 'github_out' },
      d.demoUrl && { href: d.demoUrl, label: 'Live demo', track: undefined },
    ].filter((l): l is { href: string; label: string; track: string | undefined } => Boolean(l));

// The briefing: problem, your part, what exists today, key result. Only restates the page.
const briefing = d.glance
  ? [
      { label: 'Problem', value: d.glance.problem, key: 'problem' },
      { label: 'My part', value: d.glance.part, key: 'part' },
      { label: 'What exists today', value: d.glance.exists, key: 'exists' },
      { label: 'Key result', value: d.glance.result, key: 'result' },
    ].filter((g) => g.value || SHOW_TODOS)
  : [];

// The record's index: the chapters that actually render, then the end of the record.
const hasLinksBlock = Boolean(d.restricted || links.length || SHOW_TODOS);
const sections = [
  ...renderedSections(project.body, SHOW_TODOS),
  'Status',
  ...(hasLinksBlock ? [d.restricted ? 'Sealed' : 'Links'] : []),
];
const anchor = (title: string) =>
  title === 'Status'
    ? 'status'
    : title === 'Sealed' || title === 'Links'
      ? 'links'
      : sectionId(title);
const showIndex = sections.length >= 4;
const neighbour = (p: Project) => ({
  href: `/projects/${p.id}`,
  recordId: idOf(p),
  title: p.data.title,
  cover: p.data.cover,
});
---

<BaseLayout title={d.title} og={`project-${project.id}`} description={d.summary} underNav>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)}></script>
  <RecordHead
    recordId={recordId}
    shelf={{ href: '/#lab', label: 'The lab' }}
    set={closeUp(project.id)}
    title={d.title}
    summary={d.summary}
    status={status}
    facts={facts}
    restricted={d.restricted}
    cover={
      d.cover
        ? {
            src: d.cover,
            alt: d.coverAlt ?? '',
            kind: d.coverKind,
            transitionName: `cover-${project.id}`,
          }
        : undefined
    }
  />
  {SHOW_TODOS && !d.cover && d.coverTodo && (
    <div class="wrap">
      <Todo what={d.coverTodo} block />
    </div>
  )}

  <div class:list={['record-body', { 'record-body--single': !showIndex }]}>
    {showIndex && (
      <nav class="record-index" aria-label="This record" data-spy>
        <p class="record-index__title">
          <span class="t-data">{recordId}</span> Index
        </p>
        <ol class="record-index__list" role="list">
          {sections.map((title) => (
            <li>
              <a href={`#${anchor(title)}`}>{title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="record-main">
      {briefing.length > 0 && (
        <section class="briefing" aria-labelledby="briefing-title">
          <h2 id="briefing-title" class="briefing__title">
            Briefing
          </h2>
          <dl class="briefing__grid">
            {briefing.map((g) => (
              <div class:list={['briefing__cell', `briefing__cell--${g.key}`]}>
                <dt>{g.label}</dt>
                <dd>{g.value ?? <Todo what={g.label.toLowerCase()} />}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <Content
        components={{ CaseSection, ArchDiagram, Todo, Figure, Readout, BoardStory, TesseraScenes }}
      />
    </div>
  </div>

  <RecordEnd
    recordId={recordId}
    status={status}
    withheld={withheld}
    links={links}
    linksTodo={SHOW_TODOS ? 'repository visibility decision; public links' : undefined}
    next={neighbour(next)}
    prev={neighbour(prev)}
    shelf={{ href: '/#lab', label: 'Back to the lab' }}
  />
</BaseLayout>

<script>
  import { onPage } from '../scripts/lifecycle';
  import { initSpy } from '../scripts/spy';

  onPage(() => {
    const nav = document.querySelector<HTMLElement>('[data-spy]');
    return nav ? initSpy(nav) : undefined;
  });
</script>
