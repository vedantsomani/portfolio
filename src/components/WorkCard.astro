---
// A project card: cover (clip-wiped in by scroll), title, status, summary, role. One link per card:
// the title link, stretched over the whole card (::after), so the cover is clickable without a
// second, unnamed image link. The cover carries the same transition:name as the case-study header
// image, so opening it morphs instead of wiping.
import type { ImageMetadata } from 'astro';
import Figure from './Figure.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  status?: string;
  role?: string[];
  cover: ImageMetadata;
  coverTodo?: string;
  morph?: string;
  size?: 'large' | 'small';
  /** Heading level for the title: h2 on the Projects index (no section heading above it). */
  level?: 2 | 3;
  sizes: string;
  /** The first card on a page, above the fold: its cover loads at once (it is the LCP element). */
  eager?: boolean;
}
const {
  href,
  title,
  summary,
  status,
  role = [],
  cover,
  coverTodo,
  morph,
  size = 'large',
  sizes,
  level = 3,
  eager = false,
} = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class:list={['work-card', `work-card--${size}`]}>
  <div class="work-card__cover">
    <div class="cover-wipe" transition:name={morph}>
      <Figure src={cover} alt="" todo={coverTodo} sizes={sizes} eager={eager} />
    </div>
  </div>
  <div class="work-card__meta">
    <Heading class="work-card__title">
      <a
        href={href}
        class="work-card__link"
        data-track="project_open"
        data-morph={morph ? '' : undefined}
      >
        {title}
      </a>
    </Heading>
    {status && <p class="t-data work-card__status">{status}</p>}
    <p class="work-card__summary">{summary}</p>
    {role.length > 0 && <p class="work-card__role t-small">{role.join(', ')}</p>}
  </div>
</article>
