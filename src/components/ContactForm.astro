---
import { actions, isInputError } from 'astro:actions';
import Button from './Button.astro';
import Todo from './Todo.astro';
import { reasons, site } from '../data/site';

// Renders the server result of a no-JS POST. With JS, the script below submits in place instead.
interface Props {
  values?: Record<string, string>;
}
const { values = {} } = Astro.props;

const result = Astro.getActionResult(actions.contact);
const sent = result?.data?.sent === true;
const fieldErrors: Record<string, string[] | undefined> =
  result?.error && isInputError(result.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : null;

// ?reason=internship preselects the reason (links from elsewhere on the site, or shared links).
const reasonParam = Astro.url.searchParams.get('reason') ?? '';
const selectedReason =
  values.reason ?? (reasons.some((r) => r.value === reasonParam) ? reasonParam : '');

const fields = [
  ['name', 'Name'],
  ['email', 'Email'],
  ['reason', 'Reason'],
  ['message', 'Message'],
] as const;
const errorList = fields.filter(([key]) => fieldErrors[key]?.length);
const err = (key: string) => fieldErrors[key]?.[0];
const describedBy = (key: string, hint = false) =>
  [hint && `${key}-hint`, err(key) && `${key}-error`].filter(Boolean).join(' ') || undefined;
---

<div class="contact-form" data-contact>
  <div class="form-status" role="status" tabindex="-1" data-form-success hidden={!sent}>
    <p class="t-h2">Sent. I'll reply by email.</p>
  </div>

  <form
    method="POST"
    action={actions.contact}
    class="form"
    data-contact-form
    hidden={sent}
    aria-describedby="form-intro"
  >
    <p id="form-intro" class="form__intro t-small">
      All fields are required.
    </p>

    <div
      class="form__summary"
      role="alert"
      tabindex="-1"
      data-form-summary
      hidden={!errorList.length && !formError}
    >
      {formError ? (
        <p class="form__summary-title">{formError}</p>
      ) : (
        <p class="form__summary-title">
          {errorList.length === 1 ? 'There is 1 problem' : `There are ${errorList.length} problems`}{' '}
          with the form.
        </p>
      )}
      <ul role="list" data-form-summary-list>
        {errorList.map(([key, text]) => (
          <li>
            <a href={`#${key}`}>
              {text}: {err(key)}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="form__row">
      <div class="field" data-field="name">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          maxlength="100"
          value={values.name}
          aria-invalid={err('name') ? 'true' : undefined}
          aria-describedby={describedBy('name')}
        />
        <p id="name-error" class="field__error" data-error hidden={!err('name')}>
          {err('name')}
        </p>
      </div>

      <div class="field" data-field="email">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          value={values.email}
          aria-invalid={err('email') ? 'true' : undefined}
          aria-describedby={describedBy('email')}
        />
        <p id="email-error" class="field__error" data-error hidden={!err('email')}>
          {err('email')}
        </p>
      </div>
    </div>

    <div class="field" data-field="reason">
      <label for="reason">Reason</label>
      <select
        id="reason"
        name="reason"
        required
        aria-invalid={err('reason') ? 'true' : undefined}
        aria-describedby={describedBy('reason')}
      >
        <option value="" selected={!selectedReason}>
          Choose one
        </option>
        {reasons.map((r) => (
          <option value={r.value} selected={selectedReason === r.value}>
            {r.label}
          </option>
        ))}
      </select>
      <p id="reason-error" class="field__error" data-error hidden={!err('reason')}>
        {err('reason')}
      </p>
    </div>

    <div class="field" data-field="message">
      <label for="message">Message</label>
      <textarea
        id="message"
        name="message"
        rows="7"
        required
        minlength="20"
        maxlength="5000"
        aria-invalid={err('message') ? 'true' : undefined}
        aria-describedby={describedBy('message')}
      >{values.message}</textarea>
      <p id="message-error" class="field__error" data-error hidden={!err('message')}>
        {err('message')}
      </p>
    </div>

    <div class="form__hp" aria-hidden="true">
      <label for="website">Leave this empty</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form__submit">
      <Button type="submit" data-submit>
        Send
      </Button>
      <p class="t-small form__alt">
        Prefer email?{' '}
        {site.email ? (
          <a href={`mailto:${site.email}`} data-track="email_click">
            {site.email}
          </a>
        ) : (
          <Todo what="email" />
        )}
      </p>
    </div>
  </form>
</div>

<script>
  import { actions, isInputError } from 'astro:actions';
  import { track } from '../lib/track';

  // Progressive enhancement: submit without leaving the page so typed values survive errors.
  const labels: Record<string, string> = {
    name: 'Name',
    email: 'Email',
    reason: 'Reason',
    message: 'Message',
  };

  const controlOf = (field: HTMLElement) => field.querySelector('input, select, textarea');

  function initContactForm() {
    const root = document.querySelector<HTMLElement>('[data-contact]');
    const form = root?.querySelector<HTMLFormElement>('[data-contact-form]');
    const success = root?.querySelector<HTMLElement>('[data-form-success]');
    const summary = form?.querySelector<HTMLElement>('[data-form-summary]');
    const summaryTitle = summary?.querySelector<HTMLElement>('.form__summary-title');
    const summaryList = summary?.querySelector<HTMLElement>('[data-form-summary-list]');
    const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
    if (!form || !success || !summary || !summaryTitle || !summaryList || !submit) return;

    form.noValidate = true;
    form.addEventListener('input', () => track('form_start'), { once: true });
    // Keep the ClientRouter from also handling this form.
    form.dataset.astroReload = '';

    function showSummary(title: string) {
      if (!summary || !summaryTitle) return;
      summaryTitle.textContent = title;
      summary.hidden = false;
      summary.focus();
    }

    function clearErrors() {
      form?.querySelectorAll<HTMLElement>('[data-field]').forEach((field) => {
        const control = controlOf(field);
        const error = field.querySelector<HTMLElement>('[data-error]');
        const hint = field.querySelector('.field__hint');
        control?.removeAttribute('aria-invalid');
        if (hint) control?.setAttribute('aria-describedby', hint.id);
        else control?.removeAttribute('aria-describedby');
        if (error) {
          error.hidden = true;
          error.textContent = '';
        }
      });
      if (summary) summary.hidden = true;
      summaryList?.replaceChildren();
    }

    function showErrors(fields: Record<string, string[] | undefined>) {
      let count = 0;
      for (const key of Object.keys(labels)) {
        const message = fields[key]?.[0];
        const field = form?.querySelector<HTMLElement>(`[data-field="${key}"]`);
        const error = field?.querySelector<HTMLElement>('[data-error]');
        if (!message || !field || !error) continue;
        count++;
        const control = controlOf(field);
        const hint = field.querySelector('.field__hint');
        error.textContent = message;
        error.hidden = false;
        control?.setAttribute('aria-invalid', 'true');
        control?.setAttribute('aria-describedby', [hint?.id, error.id].filter(Boolean).join(' '));

        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${key}`;
        a.textContent = `${labels[key]}: ${message}`;
        li.append(a);
        summaryList?.append(li);
      }
      showSummary(
        `${count === 1 ? 'There is 1 problem' : `There are ${count} problems`} with the form.`,
      );
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      submit.disabled = true;
      submit.textContent = 'Sending…';
      const { data, error } = await actions.contact(new FormData(form));
      submit.disabled = false;
      submit.textContent = 'Send';
      if (error) {
        if (isInputError(error)) showErrors(error.fields as Record<string, string[] | undefined>);
        else showSummary(error.message);
        return;
      }
      if (data?.sent) {
        track('lead_submit');
        form.hidden = true;
        success.hidden = false;
        success.focus();
      }
    });

    // After a no-JS round trip, move focus to whatever the server rendered.
    if (!success.hidden) success.focus();
    else if (!summary.hidden) summary.focus();
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>
