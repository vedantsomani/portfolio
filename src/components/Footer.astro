---
// The footer: one quiet band. The places, the direct lines, and what made the site, said plainly.
import Todo from './Todo.astro';
import { archive, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner wrap">
    <p class="footer__name">
      <a href="/" class="footer__home">
        {site.name}
      </a>
      <span class="footer__archive t-data">{archive.title}</span>
    </p>

    <nav id="footer-nav" class="footer__nav" aria-label="Footer">
      <ul role="list">
        <li>
          <a href="/">The lab</a>
        </li>
        <li>
          <a href="/#files">Files</a>
        </li>
        <li>
          <a href="/briefing">Briefing</a>
        </li>
        <li>
          <a href="/contact">Contact</a>
        </li>
      </ul>
    </nav>

    <ul class="footer__links" role="list">
      <li>
        {site.email ? (
          <a href={`mailto:${site.email}`} data-track="email_click">
            {site.email}
          </a>
        ) : (
          <Todo what="email" />
        )}
      </li>
      <li>
        {site.github ? (
          <a href={site.github} data-track="github_out">
            GitHub
          </a>
        ) : (
          <Todo what="GitHub URL" />
        )}
      </li>
      <li>{site.linkedin ? <a href={site.linkedin}>LinkedIn</a> : <Todo what="LinkedIn URL" />}</li>
    </ul>

    <p class="footer__legal t-small">
      © {year}
      {site.name}, {site.location}
    </p>
  </div>
</footer>
