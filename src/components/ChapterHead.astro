---
import '../styles/archive/chapter.css';
// Chapter header (SITE_SPEC §5): the opening shot of every inner page. A huge title that settles as
// its tracking closes (visible from the first frame, so it never delays LCP), a copper trace that
// draws beneath it, then the kicker, lede and facts arriving in sequence. With a cover, the real
// image fills the frame behind the title, rising out of black and drifting slower than the page.
// Without JS or with reduced motion everything is simply in its final state.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import RestrictedMark from './RestrictedMark.astro';
import Todo from './Todo.astro';

interface Fact {
  label: string;
  value?: string;
  todo?: string;
  mono?: boolean;
}
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
  /** thin: index pages (Projects, Lab, About, Contact). heavy: records (case studies, lab entries). */
  weight?: 'thin' | 'heavy';
  back?: { href: string; label: string };
  cover?: { src: ImageMetadata; alt: string; transitionName?: string };
  facts?: Fact[];
  restricted?: boolean;
  /** The heading's id, for aria-labelledby on the page. */
  id?: string;
  /** 2 when something above it holds the page's h1 (the lab room on /projects). */
  level?: 1 | 2;
}
const {
  title,
  kicker,
  lede,
  weight = 'thin',
  back,
  cover,
  facts = [],
  restricted = false,
  id = 'chapter-title',
  level = 1,
} = Astro.props;
const H = level === 2 ? 'h2' : 'h1';
---

<header
  class:list={['chapter', `chapter--${weight}`, { 'chapter--cover': cover }]}
  aria-labelledby={id}
>
  {cover &&
    (cover.transitionName ? (
      <div class="chapter__cover" data-scroll="drift" transition:name={cover.transitionName}>
        <Picture
          src={cover.src}
          alt={cover.alt}
          formats={['avif']}
          fallbackFormat="jpg"
          widths={[480, 768, 1024, 1600, 2400].filter((w) => w <= cover.src.width)}
          sizes="100vw"
          loading="eager"
          decoding="async"
          quality={50}
        />
      </div>
    ) : (
      <div class="chapter__cover" data-scroll="drift">
        <Picture
          src={cover.src}
          alt={cover.alt}
          formats={['avif']}
          fallbackFormat="jpg"
          widths={[480, 768, 1024, 1600, 2400].filter((w) => w <= cover.src.width)}
          sizes="100vw"
          loading="eager"
          decoding="async"
          quality={50}
        />
      </div>
    ))}
  <div class="chapter__inner wrap">
    {back && (
      <p class="chapter__back t-small">
        <a href={back.href}>{back.label}</a>
      </p>
    )}
    {kicker && <p class="chapter__kicker">{kicker}</p>}
    <H id={id} class="chapter__title">
      {title}
    </H>
    <svg
      class="chapter__trace"
      viewBox="0 0 1000 24"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M0 12 H560 L572 4 H1000" pathLength="1"></path>
    </svg>
    {restricted && <RestrictedMark />}
    {lede && <p class="chapter__lede">{lede}</p>}
    <slot />
    {facts.length > 0 && (
      <dl class="chapter__facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd class:list={{ 't-data': f.mono }}>
              {f.value ?? <Todo what={f.todo ?? f.label} />}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</header>
