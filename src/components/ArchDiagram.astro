---
// Block diagram: columns left to right (top to bottom on narrow screens), joined by PCB-style
// traces. Labels are HTML text, never baked into an image, so they scale, translate, and read.
// links[i] labels the connection after column i (a bus, a sample rate), only where the page states
// it; the trace itself is drawn in CSS so it turns with the layout.
interface Props {
  label: string;
  columns: { title: string; nodes: string[] }[];
  links?: (string | null)[];
}
const { label, columns, links = [] } = Astro.props;
---

<figure class="arch" aria-label={label}>
  {/* Shown only inside a record, where every figure is a numbered exhibit. */}
  <p class="figure__exhibit">
    <span class="figure__no"></span>
    <span class="figure__kind">Schematic</span>
  </p>
  <ol class="arch__flow" role="list">
    {columns.map((col, i) => (
      <li class="arch__col" style={`--i: ${i}`}>
        {i > 0 && (
          <span class="arch__link">
            <span class="arch__wire" aria-hidden="true" />
            {links[i - 1] && (
              <span class="arch__link-label t-data">
                <span class="visually-hidden">Link: </span>
                {links[i - 1]}
              </span>
            )}
          </span>
        )}
        <div class="arch__block">
          <p class="arch__title t-small">{col.title}</p>
          <ul class="arch__nodes" role="list">
            {col.nodes.map((n) => (
              <li>{n}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
  <figcaption class="visually-hidden">{label}</figcaption>
</figure>
