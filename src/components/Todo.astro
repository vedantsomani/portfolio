---
// Visible marker for content Vedant still has to supply. Dev only: renders nothing in production.
// Status text, so it is set in mono.
import { SHOW_TODOS } from '../lib/todo';

interface Props {
  what: string;
  block?: boolean;
}
const { what, block = false } = Astro.props;
const Tag = block ? 'p' : 'span';
---

{SHOW_TODOS && (
  <Tag class:list={['todo', 't-data', { 'todo--block': block }]}>TODO(vedant): {what}</Tag>
)}
