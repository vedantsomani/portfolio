---
// A titled page section on the 12-column grid.
// hang: heading in columns 1–3, content in 4–12. statement: display-size heading across the width.
interface Props {
  id: string;
  title: string;
  hang?: boolean;
  statement?: boolean;
  class?: string;
}
const { id, title, hang = false, statement = false, class: className } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  class:list={[
    'section',
    'grid',
    { 'section--hang': hang, 'section--statement': statement },
    className,
  ]}
  aria-labelledby={headingId}
>
  <div class="section__head">
    {statement ? (
      <div class="section__statement display-fit">
        <h2 id={headingId} class="t-display">
          {title}
        </h2>
      </div>
    ) : (
      <h2 id={headingId}>{title}</h2>
    )}
    <slot name="aside" />
  </div>
  <div class="section__body">
    <slot />
  </div>
</section>
