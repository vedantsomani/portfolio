---
// A titled page section on the 12-column grid. `hang` puts the heading in columns 1–3.
interface Props {
  id: string;
  title: string;
  hang?: boolean;
  class?: string;
}
const { id, title, hang = false, class: className } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  class:list={['section', 'grid', { 'section--hang': hang }, className]}
  aria-labelledby={headingId}
>
  <div class="section__head">
    <h2 id={headingId}>{title}</h2>
    <slot name="aside" />
  </div>
  <div class="section__body">
    <slot />
  </div>
</section>
