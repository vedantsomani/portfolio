---
import '../styles/archive/record.css';
// The opening of a record (SITE_SPEC §5): case studies and lab entries are recovered records in
// the archive, and this is the moment one is retrieved. The cover is exhibit 00: it arrives in the
// machine's grade (red, edge-hard) and crosses into the human grade behind a scan line. Over it
// sits the record's title card, set like the cold open's credits. Below, the file card: status
// first, then the facts, every one restated from the record's own page. A restricted record opens
// on a classification band instead, and a record with no image gets a sealed field with its ID,
// over the set's close-up of it on its shelf in the lab (the frame the lab's push-in ends on), so
// opening a record from the room continues the same shot.
// Without JS or with reduced motion everything is simply in its final state.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Todo from './Todo.astro';

interface Fact {
  label: string;
  value?: string;
  todo?: string;
  mono?: boolean;
}
interface Props {
  /** Canonical record ID: R-01… (case studies), L-01… (lab entries). */
  recordId: string;
  /** Where the record sits in the archive, for the path line. */
  shelf: { href: string; label: string };
  title: string;
  summary?: string;
  status?: string;
  facts?: Fact[];
  restricted?: boolean;
  cover?: {
    src: ImageMetadata;
    alt: string;
    /** Evidence class of the cover, e.g. "KiCad render, not a photograph". */
    kind?: string;
    transitionName?: string;
  };
  /** The lab set's close-up of this record (a render; decoration behind a sealed record). */
  set?: string;
}
const {
  recordId,
  shelf,
  title,
  summary,
  status,
  facts = [],
  restricted = false,
  cover,
  set,
} = Astro.props;
const number = recordId.replace(/^[A-Z]-/, '');
const kindWord = recordId.startsWith('L-') ? 'Lab record' : 'Record';
---

<header
  class:list={[
    'rhead',
    { 'rhead--cover': cover, 'rhead--sealed': !cover, 'rhead--restricted': restricted },
  ]}
  aria-labelledby="record-title"
>
  {restricted && (
    <p class="rhead__band">
      <span class="rhead__band-mark" aria-hidden="true" />
      <strong>Restricted — architecture and results only.</strong>
      <span>No control laws, protocol internals, key handling, or repositories.</span>
    </p>
  )}

  <div class="rhead__frame">
    {cover ? (
      <figure class="rhead__cover">
        {cover.transitionName ? (
          <div class="rhead__cover-img" transition:name={cover.transitionName}>
            <Picture
              src={cover.src}
              alt={cover.alt}
              formats={['avif']}
              fallbackFormat="jpg"
              widths={[480, 768, 1024, 1600, 2400].filter((w) => w <= cover.src.width)}
              sizes="100vw"
              loading="eager"
              decoding="async"
              quality={40}
            />
          </div>
        ) : (
          <div class="rhead__cover-img">
            <Picture
              src={cover.src}
              alt={cover.alt}
              formats={['avif']}
              fallbackFormat="jpg"
              widths={[480, 768, 1024, 1600, 2400].filter((w) => w <= cover.src.width)}
              sizes="100vw"
              loading="eager"
              decoding="async"
              quality={40}
            />
          </div>
        )}
        {cover.kind && (
          <figcaption class="rhead__exhibit t-data">
            <span>Exhibit 00</span>
            <span>{cover.kind}</span>
          </figcaption>
        )}
      </figure>
    ) : (
      <Fragment>
        {set && <img class="rhead__set" src={set} alt="" decoding="async" aria-hidden="true" />}
        <p class="rhead__ghost" aria-hidden="true" data-ghost>
          {recordId}
        </p>
      </Fragment>
    )}

    <span class="rhead__corner rhead__corner--tl" aria-hidden="true"></span>
    <span class="rhead__corner rhead__corner--tr" aria-hidden="true"></span>

    <div class="rhead__card wrap">
      <nav class="rhead__path t-data" aria-label="Archive path">
        <a href={shelf.href}>{shelf.label}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{recordId}</span>
      </nav>
      <p class="rhead__kicker">
        {kindWord} {number}
      </p>
      <h1 id="record-title" class="rhead__title">
        {title}
      </h1>
      {summary && <p class="rhead__summary">{summary}</p>}
    </div>
  </div>

  <div class="rhead__file wrap">
    <dl class="rhead__fields">
      <div class="rhead__field rhead__field--status">
        <dt>Status</dt>
        <dd>{status ? <span class="rhead__stamp">{status}</span> : <Todo what="status" />}</dd>
      </div>
      {facts.map((f, i) => (
        <div class="rhead__field" style={`--n: ${i + 1}`}>
          <dt>{f.label}</dt>
          <dd class:list={{ 't-data': f.mono }}>{f.value ?? <Todo what={f.todo ?? f.label} />}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<script>
  import { onPage } from '../scripts/lifecycle';

  // The hollow record ID is set huge in Archivo; shown before the font arrives it would change
  // width on swap and shift. It appears once the face is ready (decoration only: without JS the
  // sealed field is simply plain).
  onPage(() => {
    const ghost = document.querySelector<HTMLElement>('[data-ghost]');
    if (!ghost) return;
    void document.fonts.load('800 1em Archivo').then(() => ghost.classList.add('is-ready'));
  });
</script>
