---
// A lab entry as a lab record (SITE_SPEC §5): the same retrieval, chapters, and end as a case study.
// PRAHARI and SKYNET are restricted, so they open on the classification band and end sealed.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecordHead from '../../components/RecordHead.astro';
import RecordEnd from '../../components/RecordEnd.astro';
import CaseSection from '../../components/CaseSection.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import Readout from '../../components/Readout.astro';
import Todo from '../../components/Todo.astro';
import { SHOW_TODOS } from '../../lib/todo';
import { getDossiers } from '../../lib/dossiers';
import { closeUp } from '../../lib/lab-set';
import {
  formatDate,
  getLabEntries,
  recordIds,
  statusLabel,
  type LabEntry,
} from '../../lib/content';

export const getStaticPaths = (async () => {
  const entries = await getLabEntries();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries.length > 1 ? entries[(i + 1) % entries.length] : undefined },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: LabEntry;
  next?: LabEntry;
}
const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const ids = await recordIds();
const recordId = ids.get(`lab/${entry.id}`) ?? 'L-00';
const summary =
  d.result ?? d.hypothesis ?? `${d.title}, a ${d.discipline.toLowerCase()} entry in the lab.`;
const facts = [
  { label: 'Date', value: formatDate(d.date), todo: 'date', mono: true },
  { label: 'Discipline', value: d.discipline },
].filter((f) => f.value || SHOW_TODOS);
// artifactTodo marks a generated placeholder: dev only (SITE_SPEC §3).
const showArtifact = !d.artifactTodo || SHOW_TODOS;
const withheld = d.restricted
  ? (await getDossiers()).find((x) => x.id === entry.id)?.withheld
  : undefined;
---

<BaseLayout title={d.title} og={`lab-${entry.id}`} description={summary} underNav>
  <RecordHead
    recordId={recordId}
    shelf={{ href: '/#lab', label: 'The lab' }}
    set={closeUp(entry.id)}
    title={d.title}
    summary={d.hypothesis && !d.result ? d.hypothesis : undefined}
    status={statusLabel(d.status)}
    facts={facts}
    restricted={d.restricted}
    cover={showArtifact ? { src: d.artifact, alt: d.artifactAlt } : undefined}
  />

  <div class="record-body record-body--single">
    <div class="record-main">
      <Content components={{ CaseSection, ArchDiagram, Todo, Readout }} />
    </div>
  </div>

  <RecordEnd
    recordId={recordId}
    status={statusLabel(d.status)}
    withheld={withheld}
    next={
      next
        ? {
            href: `/lab/${next.id}`,
            recordId: ids.get(`lab/${next.id}`) ?? 'L-00',
            title: next.data.title,
          }
        : undefined
    }
    shelf={{ href: '/#lab', label: 'Back to the lab' }}
  />
</BaseLayout>
