---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroCredits from '../components/IntroCredits.astro';
import LabRoom from '../components/LabRoom.astro';
import PhoneHome from '../components/PhoneHome.astro';
import Film from '../components/Film.astro';
import Files from '../components/Files.astro';
import Transmission from '../components/Transmission.astro';
import { getLabSet } from '../lib/lab-set';

// The archive: the cold open, then the film (a crew comes home to a dark planet, lands in a street
// the machines took, and walks into the lab the signal comes from), which ends in the lab: the
// page's interface. Every record is on a shelf; the files and the transmission open over the room.
// The recruiter briefing and contact are the only other pages; each record opens as its own file.
const lab = await getLabSet();
const film = Object.keys(import.meta.glob('../data/film.json', { eager: true })).length > 0;
---

<BaseLayout
  title="Vedant Somani"
  fontPreload={false}
  underNav
  experience
  description="Vedant Somani builds flight hardware, secure comms, and space-data pipelines from the silicon up: embedded systems, drones, and the software around them."
>
  <IntroCredits />
  <PhoneHome film={film} />
  {lab && <LabRoom data={lab} film={film} />}
  <Film />
  <Files />
  <Transmission />
  <div class="panel-scrim" data-panel-scrim hidden></div>
</BaseLayout>

<script>
  import { onPage } from '../scripts/lifecycle';
  import { initPanels } from '../scripts/panels';

  onPage(initPanels);
</script>
