---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';

// Rendered on demand so a no-JS form POST can show its result on this page.
export const prerender = false;

// Re-fill the fields after a no-JS submission that came back with errors.
let values: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.clone().formData();
    values = Object.fromEntries(
      [...data.entries()].filter(([k, v]) => k !== 'website' && typeof v === 'string'),
    ) as Record<string, string>;
  } catch {
    values = {};
  }
}
---

<BaseLayout
  title="Get in touch"
  og="contact"
  trackView="contact_open"
  description="Internships, research collaborations, and hardware projects: write to Vedant Somani about embedded systems, drones, and the software around them."
  underNav
>
  <header class="contact-head field-oxblood on-oxblood grid">
    <div class="contact-head__title display-fit">
      <h1 class="t-display">Get in touch</h1>
    </div>
    <div class="contact-head__notes">
      <p>Internships, research collaborations, and hardware projects.</p>
      <p class="contact-head__email">
        {site.email ? (
          <a href={`mailto:${site.email}`} data-track="email_click">
            {site.email}
          </a>
        ) : (
          <Todo what="email" />
        )}
      </p>
    </div>
  </header>

  <section class="section grid contact-body" aria-label="Contact form">
    <ContactForm values={values} />
  </section>
</BaseLayout>
