{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in Workers Builds (CI).
  "name": "portfolio",
  // Wraps the adapter handler to add X-Robots-Tag on non-production hosts.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // run_worker_first: static assets also pass through src/worker.ts (for X-Robots-Tag). Every asset
  // request then counts as a Worker invocation.
  "assets": { "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  // *.workers.dev URL and per-version preview URLs stay on until launch.
  // Phase 4: set "workers_dev": false once the custom domain is live.
  "workers_dev": true,
  "preview_urls": true,
  // Contact form limiter: 5 per minute per IP (the binding supports only 10 s / 60 s windows).
  // Decided: this plus the honeypot is enough. Add Turnstile only if spam appears.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Secrets (not in this file): RESEND_API_KEY, CONTACT_TO_EMAIL
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put CONTACT_TO_EMAIL
}
