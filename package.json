{
  "name": "vedant-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/og.mjs && astro build",
    "preview": "npm run build && wrangler dev",
    "preview:audit": "npm run build && wrangler dev --var PRE_LAUNCH:false",
    "astro": "astro",
    "check": "astro check && eslint . && prettier --check .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og": "node scripts/og.mjs",
    "sprites": "node scripts/hall-sprites.mjs",
    "cf-typegen": "wrangler types --include-runtime=false",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^6.4.8",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "three": "^0.186.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp@0.34.5": true,
    "workerd@1.20260921.1": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "satori": "^0.33.5",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.138.0",
    "yaml": "^2.9.1"
  }
}
